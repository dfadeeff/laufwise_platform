# Copy to .env.local

# Base URL of the backend control-plane API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Clerk (auth + organizations = tenants, ADR-0003). Get these from the Clerk dashboard:
# dashboard.clerk.com -> your app (app_3GBztRhV14Pkm8ZMol4e3vZymc2) -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...