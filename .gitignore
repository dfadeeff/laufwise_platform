# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.env
# Any backup or dated copy of an env file. One of these sat untracked in backend/ holding
# 27 live secrets, one `git add -A` away from being pushed to GitHub.
.env.bak*
.env.*.bak
*.env.bak*

# Node / Next.js
node_modules/
.next/
out/
.env.local
.env*.local
npm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/

# Project-scoped MCP servers. The IDE bridge writes a port that is assigned per
# session, so a committed copy is wrong for everyone else and stale after a restart.
# If we ever want to SHARE a project MCP server, un-ignore this and commit it then.
.mcp.json

# Runtime artifacts (backend episode logs) — anchored so it does NOT match
# source dirs like frontend/src/app/runs/
/backend/runs/
/backend/files/
*.log
# Superpowers skills (github.com/obra/superpowers, MIT): installed locally, not part of this repo.
# The copies live in .agents/skills/ (read by Codex); .claude/skills/ links to them for Claude Code.
# The project's own skills in .claude/skills/ stay tracked.
/.agents/
/.claude/skills/using-superpowers
/.claude/skills/brainstorming
/.claude/skills/writing-plans
/.claude/skills/using-git-worktrees
/.claude/skills/test-driven-development
/.claude/skills/systematic-debugging
/.claude/skills/requesting-code-review
/.claude/skills/verification-before-completion
/.claude/skills/finishing-a-development-branch
# Their default output folders for design docs and plans.
/docs/superpowers/
